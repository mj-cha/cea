# Figma 개인 액세스 토큰 (Figma > Settings > Security > Personal access tokens)
# 실제 값은 .env 에만 적고 커밋하지 않는다. 필요 권한: File content(Read), Code Connect(Write)
FIGMA_ACCESS_TOKEN=

# 공식 사이트 도메인 (가비아 DNS 연결 도메인)
VITE_SITE_URL=https://www.cea.co.kr

# Supabase 연동 설정 (Project Settings > API 에서 복사해 .env 에만 입력)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
